package com.exercicios.java.exercicio09.janelasGui.carga;

import java.awt.FlowLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;

public class JanelaVeiculosCarga implements ActionListener{

	private static JFrame janelaCarga = new JFrame();
	private static JButton buttonCadastro = new JButton();
	private static JButton buttonConsulta = new JButton();
	private static JButton buttonImprime = new JButton();
	private static JButton buttonSair = new JButton();
	private static JanelaVeiculosCarga janelaVeiculosCarga = new JanelaVeiculosCarga();
	private static JanelaImpTodosCarga jImprimeP = new JanelaImpTodosCarga();
	private static JanelaCadastroCarga jCadastroP = new JanelaCadastroCarga();
	private static JanelaConsultaCarga jConsultaP = new JanelaConsultaCarga();
	
public void carregarJanelaVeiculosCarga() {
		
		janelaCarga.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
		janelaCarga.setSize(600,300);
		janelaCarga.setTitle("VEICULOS DE PASSEIO");
		
		buttonCadastro.setText("CADASTRAR");
		buttonCadastro.setSize(10, 50);
		buttonConsulta.setText("CONSULTAR/EXCLUIR PELA PLACA");
		buttonConsulta.setSize(10, 50);
		buttonImprime.setText("IMPRIMIR/EXCLUIR TODOS");
		buttonImprime.setSize(10, 50);
		buttonSair.setText("SAIR");
		buttonSair.setSize(10, 50);
		
		janelaCarga.add(buttonCadastro);
		janelaCarga.add(buttonConsulta);
		janelaCarga.add(buttonImprime);
		janelaCarga.add(buttonSair);
		
		buttonCadastro.addActionListener(janelaVeiculosCarga);
		buttonConsulta.addActionListener(janelaVeiculosCarga);
		buttonImprime.addActionListener(janelaVeiculosCarga);
		buttonSair.addActionListener(janelaVeiculosCarga);
		
		janelaCarga.setLayout(new FlowLayout());
		janelaCarga.setVisible(true);
	}
	
	@Override
	public void actionPerformed(ActionEvent e) {

		if(e.getSource().equals(buttonCadastro)) {
			abreJanCadastroCarga();
		}
		if(e.getSource().equals(buttonConsulta)) {
			abreJanConsultaCarga();
		}
		if(e.getSource().equals(buttonImprime)) {
			jImprimeP.carregaJanelaImpTodosCarga();
		}
		if(e.getSource().equals(buttonSair)) {
			janelaCarga.dispose();
		}
	}

	private void abreJanConsultaCarga() {
		jConsultaP.carregarJanelaConsultaCarga();
	}

	private void abreJanCadastroCarga() {
		jCadastroP.carregarJanelaCadastroCarga();
	}
	
}
