package com.exercicios.java.exercicio09.backEnd;

import java.util.ArrayList;
import java.util.List;

public class BDVeiculos {

	private Passeio passeio;
	private Carga carga;

	private List<Passeio> listaPasseio = new ArrayList<>();
	private List<Carga> listaCarga = new ArrayList<>();

	public void imprimeCargaPorPlaca(String placa) {
		try {
			for(Carga c : listaCarga) {
				if(placa.equalsIgnoreCase(c.getPlaca())) {
					imprimeCarga(c, listaCarga.size());
				}
			}
		} catch (Exception e) {
		}
	}

	public Passeio imprimePasseioPorPlaca(Passeio passeio) {
		try {
			for(Passeio p : listaPasseio) {
				if(passeio.getPlaca().equalsIgnoreCase(p.getPlaca())) {
					passeio = p;
					return passeio;
				}
			}
			
		} catch (Exception e) {
			return null;
		}
		return passeio;
	}

	public void imprimeTodosCarga(List<Carga> listaCarga) {
		for(int i = 0; i < listaCarga.size() ; i++) {
			imprimeCarga(listaCarga.get(i), i);
		}
	}

	public List<Passeio> cadastroPasseio(Passeio passeio) {
		listaPasseio.add(passeio);
		return listaPasseio;
	}

	public List<Carga> cadastroCarga(Carga carga) {
		listaCarga.add(carga);
		return listaCarga;
	}

	public Boolean verificaPlaca(String placa) {
		for(Passeio passeio : listaPasseio) {
			try {
				if(placa.equalsIgnoreCase(passeio.getPlaca())) {
					return false;
				}
			} catch (Exception e) {
			}
		}
		for(Carga carga : listaCarga) {
			try {
				if(placa.equalsIgnoreCase(carga.getPlaca())) {
					return false;
				}
			} catch (Exception e) {
			}
		} 
		return true;
	}


	public void excluiCargaPorPlaca(Carga carga) {
		try {
			for(Carga c : listaCarga) {
				if(carga.getPlaca().equalsIgnoreCase(c.getPlaca())) {
					System.out.println("\n\nVeículo de carga com placa " + c.getPlaca() + " foi removido com sucesso.");
					listaCarga.remove(c);
					return;
				}
			}
		} catch (Exception e) {
		}
	} 

	public void excluiPasseioPorPlaca(Passeio passeio) {
		try {
			for(Passeio p : listaPasseio) {
				if(passeio.getPlaca().equalsIgnoreCase(p.getPlaca())) {
					System.out.println("\n\nVeículo de passeio com placa " + p.getPlaca() + " foi removido com sucesso.");
					listaPasseio.remove(p);
					return;
				}
			}
		} catch (Exception e) {
		}
	} 

	public List<Passeio> getListaPasseio() {
		return listaPasseio;
	}

	public void setListaPasseio(List<Passeio> listaPasseio) {
		this.listaPasseio = listaPasseio;
	}

	public List<Carga> getListaCarga() {
		return listaCarga;
	}

	public void setListaCarga(List<Carga> listaCarga) {
		this.listaCarga = listaCarga;
	}


}