package com.exercicios.java.exercicio08;

import java.util.ArrayList;
import java.util.List;

public class BDVeiculos {

	private Passeio passeio;
	private Carga carga;

	private List<Passeio> listaPasseio = new ArrayList<>();
	private List<Carga> listaCarga = new ArrayList<>();

	private Leitura leitura = new Leitura();	

	public void imprimeCargaPorPlaca() {
		try {
			for(Carga c : listaCarga) {
				if(carga.getPlaca().equalsIgnoreCase(c.getPlaca())) {
					imprimeCarga(c, listaCarga.size());
				}
			}
		} catch (Exception e) {
			leitura.entDados("\n\nNao existe este Veiculo de Carga no sistema - press <ENTER>");
		}
	}

	public void imprimePasseioPorPlaca() {
		try {
			for(Passeio p : listaPasseio) {
				if(passeio.getPlaca().equalsIgnoreCase(p.getPlaca())) {
					imprimePasseio(p, listaPasseio.size());
				}
			}
		} catch (Exception e) {
			leitura.entDados("\n\nNao existe este Veiculo de Passeio no sistema - press <ENTER>");
		}
	}

	public void imprimeTodosCarga() {
		for(int i = 0; i < listaCarga.size() ; i++) {
			imprimeCarga(listaCarga.get(i), i);
		}
	}

	public void imprimeTodosPasseio() {
		for(int i = 0; i < listaPasseio.size() ; i++) {
			imprimePasseio(listaPasseio.get(i), i);
		}
	}

	public void cadastraVeiculosCarga(int opcao) throws VelocException {
		for(int i = 0 ; i < 100 ; i++) {
			carga = new Carga();
			listaCarga.add(cadastroCarga(carga));
			if(listaCarga== null || retornaDadosCadastro(opcao, listaCarga.size()).equalsIgnoreCase("N") ) {
				leitura.entDados("");
				break;
			}
		}
	}



	public List<Passeio> cadastroPasseio(Passeio passeio) {
		return listaPasseio.add(passeio);
	}

	public Carga cadastroCarga(Carga carga) {
		System.out.println("\n\n==========================================");
		System.out.println("Cadastro de Veiculos de Carga");
		System.out.println("\n\n==========================================");
		String placa = leitura.entDados("Placa: ");
		if(verificaPlaca(placa) == true) {
			carga.setPlaca(placa);
			carga.setMarca(leitura.entDados("Marca: "));
			carga.setModelo(leitura.entDados("Modelo: "));
			carga.setCor(leitura.entDados("Cor: "));
			try {
				carga.setQtdRodas(Integer.parseInt(leitura.entDados("Quantidade de rodas: ")));
				try {
					carga.setVelocMax(Integer.parseInt(leitura.entDados("velocidade Maxima: ")));
				} catch (VelocException ve) {
					try {
						carga.setVelocMax(90);
					} catch (VelocException e) {
						e.printStackTrace();
					}
					System.out.println(ve.getMessage());
				}
				carga.getMotor().setPotencia(Integer.parseInt(leitura.entDados("Potencia do motor: ")));
				carga.getMotor().setQtdPist(Integer.parseInt(leitura.entDados("Quantidade de Pistoes do Motor: ")));
				carga.setTara(Integer.parseInt(leitura.entDados("Tara kg: ")));
				carga.setCargaMax(Integer.parseInt(leitura.entDados("Carga Maxima kg: ")));
			} catch (NumberFormatException nfe) {
				System.out.println("\nCaracter nao e do tipo numeral " + nfe);
			}
			return carga;
		}
		return null;
	}

	public Boolean verificaPlaca(String p) {
		for(Passeio passeio : listaPasseio) {
			try {
				if(p.equalsIgnoreCase(passeio.getPlaca())) {
					leitura.entDados("\n\nJa existe um Veiculo de Passeio no sistema com a mesma placa - press <ENTER>");
					return false;
				}
			} catch (Exception e) {
			}
		}
		for(Carga carga : listaCarga) {
			try {
				if(p.equalsIgnoreCase(carga.getPlaca())) {
					leitura.entDados("\n\nJa existe um Veiculo de Carga no sistema com a mesma placa - press <ENTER>");
					return false;
				}
			} catch (Exception e) {
			}
		} 
		return true;
	}

	public void imprimeCarga(Carga carga, int i) {
		System.out.println("\nVeiculo de Carga armazenado no endereco " + i + "(do Indice)");
		try {
			System.out.println("\nPlaca: " + carga.getPlaca());
		} catch (Exception e) {
			listaCarga.remove(i);
			return;
		}
		System.out.println("\nMarca: " + carga.getMarca());
		System.out.println("\nModelo: " + carga.getModelo());
		System.out.println("\nCor: " + carga.getCor());
		System.out.println("\nTara kg: " + carga.getTara());
		System.out.println("\nCarga Maxima kg: " + carga.getCargaMax());
		System.out.println("\nQuantidade de Rodas: " + carga.getQtdRodas());
		System.out.println("\nVelocidade Maxima: " + carga.getVelocMax() + " km/h");
		System.out.println("\nVelocidade Maxima: " + carga.calcVel(carga.getVelocMax()) + " cm/h");
		System.out.println("\nPotencia do Motor: " + carga.getMotor().getPotencia());
		System.out.println("\nQuantidade de Pistoes do Motor: " + carga.getMotor().getQtdPist());
		System.out.println("\nSoma de todos os valores contidos nos atributos numericos: " + carga.calcular());
	}

	public void imprimePasseio(Passeio passeio, int i) {
		System.out.println("\nVeiculo de Passeio armazenado no endereco " + i + " (do Indice)");
		try {
			System.out.println("\nPlaca: " + passeio.getPlaca());
		} catch (Exception e) {
			listaPasseio.remove(i);
			return;
		}
		System.out.println("\nMarca: " + passeio.getMarca());
		System.out.println("\nModelo: " + passeio.getModelo());
		System.out.println("\nCor: " + passeio.getCor());
		System.out.println("\nQuantidade de Passageiros: " + passeio.getQtdPassageiros());
		System.out.println("\nQuantidade de Rodas: " + passeio.getQtdRodas());
		System.out.println("\nVelocidade Maxima: " + passeio.getVelocMax() + " km/h");
		System.out.println("\nVelocidade Maxima: " + passeio.calcVel(passeio.getVelocMax()) + " m/h");
		System.out.println("\nPotencia do Motor: " + passeio.getMotor().getPotencia());
		System.out.println("\nQuantidade de Pistoes do Motor: " + passeio.getMotor().getQtdPist());
		System.out.println("\nSoma da quantidade de caracteres contidas nos atributos String: " + passeio.calcular());
	}



	public String retornaDadosCadastro(int opcao, int i) {
		leitura.entDados("\nVeiculo de " + defineTipoVeiculo(opcao) + " armazenado na posicao " + i + " do vetor - press <ENTER>");
		String retorno = leitura.entDados("\nDeseja cadastrar outro " + defineTipoVeiculo(opcao) + "? <S/N>");
		return retorno;
	}

	public String defineTipoVeiculo(int opcao) {
		return opcao == 1 ? "Passeio" : "Carga";
	}


	public void exibeMenuInicial() {
		System.out.println("--------------------------------------------");
		System.out.println("Sistema de gestão de Veículos - Menu Inicial");
		System.out.println("--------------------------------------------");
		System.out.println("\n");
		System.out.println("--------------------------------------------");
		System.out.println("1 - Cadastrar Veículo de Passeio");
		System.out.println("2 - Cadastrar Veículo de Carga");
		System.out.println("3 - Imprimir Todos os Veículos de Passeio");
		System.out.println("4 - Imprimir Todos os Veículos de Carga");
		System.out.println("5 - Imprimir Veículo de Passeio pela Placa");
		System.out.println("6 - Imprimir Veículo de Carga pela Placa");
		System.out.println("7 - Excluir Veículo de Passeio pela Placa");
		System.out.println("8 - Excluir Veículo de Carga pela Placa");
		System.out.println("9 - Sair do Sistema");
		System.out.println("--------------------------------------------");
	}
	
	public void excluiCargaPorPlaca(Carga carga) {
		try {
			for(Carga c : listaCarga) {
				if(carga.getPlaca().equalsIgnoreCase(c.getPlaca())) {
					System.out.println("\n\nVeículo de carga com placa " + c.getPlaca() + " foi removido com sucesso.");
					listaCarga.remove(c);
					return;
				}
			}
			leitura.entDados("\n\nNao existe este Veiculo de Carga no sistema - press <ENTER>");
		} catch (Exception e) {
			leitura.entDados("\n\nNao existe este Veiculo de Carga no sistema - press <ENTER>");
		}
	} 

	public void excluiPasseioPorPlaca(Passeio passeio) {
		try {
			for(Passeio p : listaPasseio) {
				if(passeio.getPlaca().equalsIgnoreCase(p.getPlaca())) {
					System.out.println("\n\nVeículo de passeio com placa " + p.getPlaca() + " foi removido com sucesso.");
					listaPasseio.remove(p);
					return;
				}
			}
			leitura.entDados("\n\nNao existe este Veiculo de Passeio no sistema - press <ENTER>");
		} catch (Exception e) {
			leitura.entDados("\n\nNao existe este Veiculo de Passeio no sistema - press <ENTER>");
		}
	} 

	public List<Passeio> getListaPasseio() {
		return listaPasseio;
	}

	public void setListaPasseio(List<Passeio> listaPasseio) {
		this.listaPasseio = listaPasseio;
	}

	public List<Carga> getListaCarga() {
		return listaCarga;
	}

	public void setListaCarga(List<Carga> listaCarga) {
		this.listaCarga = listaCarga;
	}
	
	
}