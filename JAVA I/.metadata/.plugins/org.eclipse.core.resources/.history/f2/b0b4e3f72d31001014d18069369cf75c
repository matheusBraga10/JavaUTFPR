package com.exercicios.java.exercicio09.janelasGui;

import java.awt.FlowLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;

public class JanelaVeiculosPasseio implements ActionListener{

	private static JFrame janelaInicial = new JFrame();
	private static JButton buttonCadastro = new JButton();
	private static JButton buttonConsulta = new JButton();
	private static JButton buttonImprime = new JButton();
	private static JButton buttonSair = new JButton();
	private static JanelaVeiculosPasseio janelaVeiculosPasseio = new JanelaVeiculosPasseio();
	private static JanelaImpTodosPasseio jImprimeP = new JanelaImpTodosPasseio();
	private static JanelaCadastroPasseio jCadastroP = new JanelaCadastroPasseio();
	
public void carregarJanelaVeiculosPasseio() {
		
		janelaInicial.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
		janelaInicial.setSize(600,300);
		janelaInicial.setTitle("VEICULOS DE PASSEIO");
		
		buttonCadastro.setText("CADASTRAR");
		buttonCadastro.setSize(10, 50);
		buttonConsulta.setText("CONSULTAR/EXCLUIR PELA PLACA");
		buttonConsulta.setSize(10, 50);
		buttonImprime.setText("IMPRIMIR/EXCLUIR TODOS");
		buttonImprime.setSize(10, 50);
		buttonSair.setText("SAIR");
		buttonSair.setSize(10, 50);
		
		janelaInicial.add(buttonCadastro);
		janelaInicial.add(buttonConsulta);
		janelaInicial.add(buttonImprime);
		janelaInicial.add(buttonSair);
		
		buttonCadastro.addActionListener(janelaVeiculosPasseio);
		buttonConsulta.addActionListener(janelaVeiculosPasseio);
		buttonImprime.addActionListener(janelaVeiculosPasseio);
		buttonSair.addActionListener(janelaVeiculosPasseio);
		
		janelaInicial.setLayout(new FlowLayout());
		janelaInicial.setVisible(true);
	}
	
	@Override
	public void actionPerformed(ActionEvent e) {

		if(e.getSource().equals(buttonCadastro)) {
			jCadastroP.carregarJanelaCadastroPasseio();
		}
		if(e.getSource().equals(buttonConsulta)) {
			
		}
		if(e.getSource().equals(buttonImprime)) {
			jImprimeP.carregaJanelaImpTodospasseio();
		}
		if(e.getSource().equals(buttonSair)) {
			janelaInicial.dispose();
		}
	}
	
}
