package com.exercicios.java.exercicio09.backEnd;

import java.util.ArrayList;
import java.util.List;

public class BDVeiculos {

	private static List<Passeio> listaPasseio = new ArrayList<>();
	private static List<Carga> listaCarga = new ArrayList<>();

	public static List<Passeio> cadastroPasseio(Passeio passeio) {
		listaPasseio.add(passeio);
		return listaPasseio;
	}

	public static List<Carga> cadastroCarga(Carga carga) {
		listaCarga.add(carga);
		return listaCarga;
	}

	public static Boolean verificaPlaca(String placa) {
		for(Passeio passeio : listaPasseio) {
			try {
				if(placa.equalsIgnoreCase(passeio.getPlaca())) {
					return false;
				}
			} catch (Exception e) {
			}
		}
		for(Carga carga : listaCarga) {
			try {
				if(placa.equalsIgnoreCase(carga.getPlaca())) {
					return false;
				}
			} catch (Exception e) {
			}
		} 
		return true;
	}

	public static void excluiCargaPorPlaca(Carga carga) {
		try {
			for(Carga c : listaCarga) {
				if(carga.getPlaca().equalsIgnoreCase(c.getPlaca())) {
					System.out.println("\n\nVeículo de carga com placa " + c.getPlaca() + " foi removido com sucesso.");
					listaCarga.remove(c);
					return;
				}
			}
		} catch (Exception e) {
		}
	} 

	public static boolean excluiPasseioPorPlaca(Passeio passeio) {
			for(Passeio p : listaPasseio) {
				if(passeio.getPlaca().equalsIgnoreCase(p.getPlaca())) {
					listaPasseio.remove(p);
					return true;
				}
			}
		return false;
	} 

	public static List<Passeio> getListaPasseio() {
		return listaPasseio;
	}

	public void setListaPasseio(List<Passeio> listaPasseio) {
		BDVeiculos.listaPasseio = listaPasseio;
	}

	public static List<Carga> getListaCarga() {
		return listaCarga;
	}

	public void setListaCarga(List<Carga> listaCarga) {
		BDVeiculos.listaCarga = listaCarga;
	}


}