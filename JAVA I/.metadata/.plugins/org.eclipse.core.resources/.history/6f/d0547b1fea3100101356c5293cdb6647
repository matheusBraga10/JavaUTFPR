package com.exercicios.java.exercicio09.janelasGui.carga;

import java.awt.Color;
import java.awt.FlowLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;
import java.util.List;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JOptionPane;
import javax.swing.JScrollPane;
import javax.swing.JTable;
import javax.swing.table.DefaultTableModel;

import com.exercicios.java.exercicio09.backEnd.BDVeiculos;
import com.exercicios.java.exercicio09.backEnd.Carga;

public class JanelaImpTodosCarga implements ActionListener {

    private JFrame janelaImpTodosCarga = new JFrame();

    private String[] colunasImpTodosCarga = {"Placa", "Marca","Modelo","Cor","Qtd.Rodas",
    		"Veloc Máx","Qtd.Pist","Potência","Qtd.Passageiros"};

    private DefaultTableModel modelImpTodoscarga = new DefaultTableModel(colunasImpTodoscarga,0);
    private JTable tableDadosImpTodoscarga = new JTable(modelImpTodoscarga);
    private JScrollPane barraRolagemListaImpTodoscarga = new JScrollPane(tableDadosImpTodoscarga);

    private JButton btImprimirTodos = new JButton();
    private JButton btExcluirTodos = new JButton();
    private JButton btSair = new JButton();

    private List<Carga> listaCarga = BDVeiculos.getListaCarga();

    public void carregaJanelaImpTodosCarga() {
    	
    	janelaImpTodoscarga.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
    	janelaImpTodoscarga.setSize(800,500);
    	janelaImpTodoscarga.setTitle("Exemplo de JPanel");
    	janelaImpTodoscarga.getContentPane().setBackground(Color.WHITE);
    	janelaImpTodoscarga.setTitle("Imprimir/Excluir todos");
    	
    	btImprimirTodos.setText("Imprimir Todos");
    	btImprimirTodos.setMnemonic('I');
    	btImprimirTodos.addActionListener(this);
    	btImprimirTodos.setSize(10,50);
    	
    	btExcluirTodos.setText("Excluir Todos");
    	btExcluirTodos.setMnemonic('E');
    	btExcluirTodos.addActionListener(this);
    	btExcluirTodos.setSize(10,50);
    	
    	btSair.setText("Sair");
    	btSair.setMnemonic('S');
    	btSair.addActionListener(this);
    	btSair.setSize(10,50);
    	
    	janelaImpTodoscarga.add(barraRolagemListaImpTodoscarga);
    	janelaImpTodoscarga.add(btImprimirTodos);
    	janelaImpTodoscarga.add(btExcluirTodos);
    	janelaImpTodoscarga.add(btSair);
    	
    	
    	janelaImpTodoscarga.setLayout(new FlowLayout());
    	janelaImpTodoscarga.setVisible(true);
    }
    
    @Override
    public void actionPerformed(ActionEvent act) {

        if(act.getSource().equals(btImprimirTodos)) {
            imprimeDadosCarga();
        }
        if(act.getSource().equals(btExcluirTodos)) {
            if(excluirTodosDados()) {
                JOptionPane.showMessageDialog(null,"Dados removidos" , "Sucesso",  JOptionPane.INFORMATION_MESSAGE);
                DefaultTableModel model = new DefaultTableModel(colunasImpTodoscarga,0);
                tableDadosImpTodoscarga.setModel(model);
                return;
            }
            return;
        }
        if(act.getSource().equals(btSair)) {
            janelaImpTodoscarga.dispose();
        }
    }
    public void imprimeDadosCarga() {
        if(listaCarga.isEmpty()) {
            JOptionPane.showMessageDialog(null,"Não há veículos de carga cadastrados." , "ERRO",  JOptionPane.ERROR_MESSAGE);
        } else {
            modelImpTodoscarga = new DefaultTableModel(colunasImpTodoscarga,0);
            for(Carga carga: listaCarga ) {
    			String[] dados = {carga.getPlaca(), carga.getMarca(), carga.getModelo(), carga.getCor(), 
    					String.valueOf(carga.getQtdRodas()), String.valueOf(carga.getVelocMax()), 
    					String.valueOf(carga.getMotor().getQtdPist()), String.valueOf(carga.getMotor().getPotencia()),
    					String.valueOf(carga.getQtdPassageiros())};
    			modelImpTodoscarga.addRow(dados);
    		}
            tableDadosImpTodoscarga.setModel(modelImpTodoscarga);
        }
    }

    public boolean excluirTodosDados() {
        if(listaCarga.isEmpty()) {
            JOptionPane.showMessageDialog(null,"Não há dados a serem removidos." , "ERRO",  JOptionPane.ERROR_MESSAGE);
            return false;
        } else {
            listaCarga = new ArrayList<>();
        }
        return true;
    }
}
