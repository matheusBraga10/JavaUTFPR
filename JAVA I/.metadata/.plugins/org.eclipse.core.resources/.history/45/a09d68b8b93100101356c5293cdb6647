package com.exercicios.java.exercicio09.janelasGui;

import java.awt.FlowLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JTextField;

import com.exercicios.java.exercicio09.backEnd.BDVeiculos;
import com.exercicios.java.exercicio09.backEnd.Passeio;
import com.exercicios.java.exercicio09.backEnd.VelocException;

public class JanelaCadastroPasseio implements ActionListener{

	private static JFrame janelaCadastroPasseio = new JFrame();

	private static JLabel labelPlaca = new JLabel();
	private static JLabel labelMarca = new JLabel();
	private static JLabel labelModelo = new JLabel();
	private static JLabel labelCor = new JLabel();
	private static JLabel labelQtdRodas= new JLabel();
	private static JLabel labelVelMax = new JLabel();
	private static JLabel labelQtdPist = new JLabel();
	private static JLabel labelPotencia = new JLabel();
	private static JLabel labelQtdPassageiros = new JLabel();

	private static JTextField textPlaca = new JTextField(20);
	private static JTextField textMarca = new JTextField(20);
	private static JTextField textModelo = new JTextField(20);
	private static JTextField textCor = new JTextField(20);
	private static JTextField textQtdRodas= new JTextField(20);
	private static JTextField textVelMax = new JTextField(20);
	private static JTextField textQtdPist = new JTextField(20);
	private static JTextField textPotencia = new JTextField(20);
	private static JTextField textQtdPassageiros = new JTextField(20);

	private static JButton buttonConsultar = new JButton();
	private static JButton buttonExcluir = new JButton();
	private static JButton buttonSair = new JButton();

	private static JanelaCadastroPasseio janelaCadPasseio = new JanelaCadastroPasseio();
	private static BDVeiculos bdVeiculos = new BDVeiculos();
	private  Passeio passeio;

	public void carregarJanelaCadastroPasseio() {

		janelaCadastroPasseio.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
		janelaCadastroPasseio.setSize(300,500);
		janelaCadastroPasseio.setTitle("VEICULOS DE PASSEIO");

		labelPlaca.setText("Placa: ");
		textPlaca.setText("");
		labelMarca.setText("Marca: ");
		textMarca.setText("");
		labelModelo.setText("Modelo: ");
		textModelo.setText("");
		labelCor.setText("Cor: ");
		textCor.setText("");
		labelQtdRodas.setText("Quantidade de rodas: ");
		textQtdRodas.setText("");
		labelVelMax.setText("Velocidade Máxima: ");
		textVelMax.setText("");
		labelQtdPist.setText("Quantidade de Pistões: ");
		textQtdPist.setText("");
		labelPotencia.setText("Potencia: ");
		textPotencia.setText("");
		labelQtdPassageiros.setText("Quantidade de Passageiros: ");
		textQtdPassageiros.setText("");

		buttonConsultar.setText("CADASTRAR");
		buttonConsultar.setSize(10, 50);
		buttonExcluir.setText("LIMPAR");
		buttonExcluir.setSize(10, 50);
		buttonNovo.setText("NOVO");
		buttonNovo.setSize(10, 50);
		buttonSair.setText("SAIR");
		buttonSair.setSize(10, 50);

		janelaCadastroPasseio.add(labelPlaca);
		janelaCadastroPasseio.add(textPlaca);
		janelaCadastroPasseio.add(labelMarca);
		janelaCadastroPasseio.add(textMarca);
		janelaCadastroPasseio.add(labelModelo);
		janelaCadastroPasseio.add(textModelo);
		janelaCadastroPasseio.add(labelCor);
		janelaCadastroPasseio.add(textCor);
		janelaCadastroPasseio.add(labelQtdRodas);
		janelaCadastroPasseio.add(textQtdRodas);
		janelaCadastroPasseio.add(labelVelMax);
		janelaCadastroPasseio.add(textVelMax);
		janelaCadastroPasseio.add(labelQtdPist);
		janelaCadastroPasseio.add(textQtdPist);
		janelaCadastroPasseio.add(labelPotencia);
		janelaCadastroPasseio.add(textPotencia);
		janelaCadastroPasseio.add(labelQtdPassageiros);
		janelaCadastroPasseio.add(textQtdPassageiros);

		janelaCadastroPasseio.add(buttonConsultar);
		janelaCadastroPasseio.add(buttonExcluir);
		janelaCadastroPasseio.add(buttonNovo);
		janelaCadastroPasseio.add(buttonSair);

		buttonConsultar.addActionListener(janelaCadPasseio);
		buttonExcluir.addActionListener(janelaCadPasseio);
		buttonNovo.addActionListener(janelaCadPasseio);
		buttonSair.addActionListener(janelaCadPasseio);

		janelaCadastroPasseio.setLayout(new FlowLayout());
		janelaCadastroPasseio.setVisible(true);
	}

	@Override
	public void actionPerformed(ActionEvent e) {

		if(e.getSource().equals(buttonConsultar)) {
			passeio = new Passeio();
			passeio.setPlaca(textPlaca.getText());
			passeio.setMarca(textMarca.getText());
			passeio.setModelo(textModelo.getText());
			passeio.setCor(textCor.getText());
			passeio.setQtdRodas(Integer.parseInt(textQtdRodas.getText()));
			try {
				passeio.setVelocMax(Integer.parseInt(textVelMax.getText()));
			} catch (NumberFormatException e1) {
				e1.printStackTrace();
			} catch (VelocException e1) {
				e1.printStackTrace();
			}
			passeio.getMotor().setQtdPist(Integer.parseInt(textQtdPist.getText()));
			passeio.getMotor().setPotencia(Integer.parseInt(textPotencia.getText()));
			passeio.setQtdPassageiros(Integer.parseInt(textQtdPassageiros.getText()));
			bdVeiculos.verificaPlaca(passeio.getPlaca());
			bdVeiculos.cadastroPasseio(passeio);
		}
		if(e.getSource().equals(buttonExcluir)) {
			textPlaca.setText("");
			textMarca.setText("");
			textModelo.setText("");
			textCor.setText("");
			textQtdRodas.setText("");
			textVelMax.setText("");
			textQtdPist.setText("");
			textPotencia.setText("");
			textQtdPassageiros.setText("");
		}
		if(e.getSource().equals(buttonNovo)) {
			passeio = new Passeio();
			textPlaca.setText("");
			textMarca.setText("");
			textModelo.setText("");
			textCor.setText("");
			textQtdRodas.setText("");
			textVelMax.setText("");
			textQtdPist.setText("");
			textPotencia.setText("");
			textQtdPassageiros.setText("");
		}
		if(e.getSource().equals(buttonSair)) {
			janelaCadastroPasseio.dispose();
		}
	}
}
