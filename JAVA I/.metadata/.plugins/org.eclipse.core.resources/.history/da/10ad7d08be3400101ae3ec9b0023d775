package com.exercicios.java.exercicio09.janelasGui.carga;

import java.awt.FlowLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JTextField;

import com.exercicios.java.exercicio09.backEnd.BDVeiculos;
import com.exercicios.java.exercicio09.backEnd.Carga;
import com.exercicios.java.exercicio09.backEnd.VelocException;

public class JanelaCadastroCarga implements ActionListener{

	private static JFrame janelaCadastroCarga = new JFrame();

	private static JLabel labelPlaca = new JLabel();
	private static JLabel labelMarca = new JLabel();
	private static JLabel labelModelo = new JLabel();
	private static JLabel labelCor = new JLabel();
	private static JLabel labelQtdRodas= new JLabel();
	private static JLabel labelVelMax = new JLabel();
	private static JLabel labelQtdPist = new JLabel();
	private static JLabel labelPotencia = new JLabel();
	private static JLabel labelTara = new JLabel();
	private static JLabel labelCargaMax = new JLabel();

	private static JTextField textPlaca = new JTextField(20);
	private static JTextField textMarca = new JTextField(20);
	private static JTextField textModelo = new JTextField(20);
	private static JTextField textCor = new JTextField(20);
	private static JTextField textQtdRodas= new JTextField(20);
	private static JTextField textVelMax = new JTextField(20);
	private static JTextField textQtdPist = new JTextField(20);
	private static JTextField textPotencia = new JTextField(20);
	private static JTextField textTara = new JTextField(20);
	private static JTextField textCargaMax = new JTextField(20);

	private static JButton buttonCadastrar = new JButton();
	private static JButton buttonLimpar = new JButton();
	private static JButton buttonNovo = new JButton();
	private static JButton buttonSair = new JButton();

	private static JanelaCadastroCarga janelaCadCarga = new JanelaCadastroCarga();
	private  Carga carga;

	public void carregarJanelaCadastroCarga() {

		janelaCadastroCarga.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
		janelaCadastroCarga.setSize(270,600);
		janelaCadastroCarga.setTitle("VEICULOS DE CARGA");

		labelPlaca.setText("Placa: ");
		textPlaca.setText("");
		labelMarca.setText("Marca: ");
		textMarca.setText("");
		labelModelo.setText("Modelo: ");
		textModelo.setText("");
		labelCor.setText("Cor: ");
		textCor.setText("");
		labelQtdRodas.setText("Quantidade de rodas: ");
		textQtdRodas.setText("");
		labelVelMax.setText("Velocidade Máxima: ");
		textVelMax.setText("");
		labelQtdPist.setText("Quantidade de Pistões: ");
		textQtdPist.setText("");
		labelPotencia.setText("Potencia: ");
		textPotencia.setText("");
		labelTara.setText("Tara: ");
		textTara.setText("");
		labelCargaMax.setText("Carga Máxima: ");
		textCargaMax.setText("");

		buttonCadastrar.setText("CADASTRAR");
		buttonCadastrar.setSize(10, 50);
		buttonLimpar.setText("LIMPAR");
		buttonLimpar.setSize(10, 50);
		buttonNovo.setText("NOVO");
		buttonNovo.setSize(10, 50);
		buttonSair.setText("SAIR");
		buttonSair.setSize(10, 50);

		janelaCadastroCarga.add(labelPlaca);
		janelaCadastroCarga.add(textPlaca);
		janelaCadastroCarga.add(labelMarca);
		janelaCadastroCarga.add(textMarca);
		janelaCadastroCarga.add(labelModelo);
		janelaCadastroCarga.add(textModelo);
		janelaCadastroCarga.add(labelCor);
		janelaCadastroCarga.add(textCor);
		janelaCadastroCarga.add(labelQtdRodas);
		janelaCadastroCarga.add(textQtdRodas);
		janelaCadastroCarga.add(labelVelMax);
		janelaCadastroCarga.add(textVelMax);
		janelaCadastroCarga.add(labelQtdPist);
		janelaCadastroCarga.add(textQtdPist);
		janelaCadastroCarga.add(labelPotencia);
		janelaCadastroCarga.add(textPotencia);
		janelaCadastroCarga.add(labelTara);
		janelaCadastroCarga.add(textTara);
		janelaCadastroCarga.add(labelCargaMax);
		janelaCadastroCarga.add(textCargaMax);

		janelaCadastroCarga.add(buttonCadastrar);
		janelaCadastroCarga.add(buttonLimpar);
		janelaCadastroCarga.add(buttonNovo);
		janelaCadastroCarga.add(buttonSair);

		buttonCadastrar.addActionListener(janelaCadCarga);
		buttonLimpar.addActionListener(janelaCadCarga);
		buttonNovo.addActionListener(janelaCadCarga);
		buttonSair.addActionListener(janelaCadCarga);

		janelaCadastroCarga.setLayout(new FlowLayout());
		janelaCadastroCarga.setVisible(true);
	}

	@Override
	public void actionPerformed(ActionEvent e) {

		if(e.getSource().equals(buttonCadastrar)) {
			cadastrar();
		}
		if(e.getSource().equals(buttonLimpar)) {
			limpar();
		}
		if(e.getSource().equals(buttonNovo)) {
			insereNovaCarga();
		}
		if(e.getSource().equals(buttonSair)) {
			janelaCadastroCarga.dispose();
		}
	}

	private void insereNovaCarga() {
		carga = new Carga();
		limpar();
	}

	private void limpar() {
		textPlaca.setText("");
		textMarca.setText("");
		textModelo.setText("");
		textCor.setText("");
		textQtdRodas.setText("");
		textVelMax.setText("");
		textQtdPist.setText("");
		textPotencia.setText("");
		textTara.setText("");
		textCargaMax.setText("");
		textPlaca.requestFocus();
	}

	private void cadastrar() {
		carga = new Carga();
		carga.setPlaca(textPlaca.getText());
		if(carga.getPlaca().isEmpty() || carga.getPlaca().isBlank()) {
			JOptionPane.showMessageDialog(null,"Informe a placa do veículo." ,"ERRO",  JOptionPane.ERROR_MESSAGE);
			textPlaca.requestFocus();
			return;
		}
		carga.setMarca(textMarca.getText());
		carga.setModelo(textModelo.getText());
		carga.setCor(textCor.getText());
		try {
			carga.setQtdRodas(Integer.parseInt(textQtdRodas.getText()));
			carga.setVelocMax(Integer.parseInt(textVelMax.getText()));
			carga.getMotor().setQtdPist(Integer.parseInt(textQtdPist.getText()));
			carga.getMotor().setPotencia(Integer.parseInt(textPotencia.getText()));
			carga.setTara(Integer.parseInt(textTara.getText()));
			carga.setCargaMax(Integer.parseInt(textCargaMax.getText()));
		} catch (NumberFormatException e1) {
			JOptionPane.showMessageDialog(null,"Para os campos 'Quantidade de rodas', 'Velocidade Máxima', 'Qauntidade de Pistões', 'Potência',"
					+ " 'Tara', 'Carga Máxima'.\nDeve ser informado valores numerais. Favor alterar." ,
					"ERRO",  JOptionPane.ERROR_MESSAGE);
			e1.printStackTrace();
			return;
		} catch (VelocException e1) {
			if(carga.getVelocMax() > 80 || carga.getVelocMax() <= 110) {
				JOptionPane.showMessageDialog(null,"A velocidade máxima está fora dos limites brasileiros.\nDeve estar entre 80 km/h e 110 km/h." ,
						"ERRO",  JOptionPane.ERROR_MESSAGE);
			}
			e1.printStackTrace();
			return;
		}
		if(BDVeiculos.verificaPlaca(carga.getPlaca()) == true) {
			BDVeiculos.cadastroCarga(carga);
			JOptionPane.showMessageDialog(null,"Registro cadastrado com sucesso." ,
					"INFORMAÇÃO",  JOptionPane.INFORMATION_MESSAGE);
		} else {
			JOptionPane.showMessageDialog(null,"Esta placa já se encontra cadastrada no sistema.\nFavor informar nova placa." 
					,"ERRO",  JOptionPane.ERROR_MESSAGE);
		}
	}
}
