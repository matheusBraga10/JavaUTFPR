package com.exercicios.java.exercicio09.janelasGui;

import java.awt.FlowLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JTextField;

import com.exercicios.java.exercicio09.backEnd.BDVeiculos;
import com.exercicios.java.exercicio09.backEnd.Passeio;
import com.exercicios.java.exercicio09.backEnd.VelocException;

public class JanelaConsultaPasseio implements ActionListener{

	private static JFrame janelaConsultaPasseio = new JFrame();

	private static JLabel labelPlaca = new JLabel();
	private static JLabel labelMarca = new JLabel();
	private static JLabel labelModelo = new JLabel();
	private static JLabel labelCor = new JLabel();
	private static JLabel labelQtdRodas= new JLabel();
	private static JLabel labelVelMax = new JLabel();
	private static JLabel labelQtdPist = new JLabel();
	private static JLabel labelPotencia = new JLabel();
	private static JLabel labelQtdPassageiros = new JLabel();

	private static JTextField textPlaca = new JTextField(20);
	private static JTextField textMarca = new JTextField(20);
	private static JTextField textModelo = new JTextField(20);
	private static JTextField textCor = new JTextField(20);
	private static JTextField textQtdRodas= new JTextField(20);
	private static JTextField textVelMax = new JTextField(20);
	private static JTextField textQtdPist = new JTextField(20);
	private static JTextField textPotencia = new JTextField(20);
	private static JTextField textQtdPassageiros = new JTextField(20);

	private static JButton buttonConsulta = new JButton();
	private static JButton buttonExcluir = new JButton();
	private static JButton buttonSair = new JButton();

	private static JanelaConsultaPasseio janelaConsPasseio = new JanelaConsultaPasseio();
	private static BDVeiculos bdVeiculos = new BDVeiculos();
	private  Passeio passeio;

	public void carregarJanelaConsultaPasseio() {

		janelaConsultaPasseio.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
		janelaConsultaPasseio.setSize(300,500);
		janelaConsultaPasseio.setTitle("VEICULOS DE PASSEIO");

		labelPlaca.setText("Inform a Placa: ");
		textPlaca.setText("");
		labelMarca.setText("Marca: ");
		textMarca.setText("");
		textMarca.setEditable(false);
		labelModelo.setText("Modelo: ");
		textModelo.setText("");
		textModelo.setEditable(false);
		labelCor.setText("Cor: ");
		textCor.setText("");
		textCor.setEditable(false);
		labelQtdRodas.setText("Quantidade de rodas: ");
		textQtdRodas.setText("");
		textQtdRodas.setEditable(false);
		labelVelMax.setText("Velocidade Máxima: ");
		textVelMax.setText("");
		textVelMax.setEditable(false);
		labelQtdPist.setText("Quantidade de Pistões: ");
		textQtdPist.setText("");
		textQtdPist.setEditable(false);
		labelPotencia.setText("Potencia: ");
		textPotencia.setText("");
		textPotencia.setEditable(false);
		labelQtdPassageiros.setText("Quantidade de Passageiros: ");
		textQtdPassageiros.setText("");
		textQtdPassageiros.setEditable(false);

		buttonConsulta.setText("CONSULTAR");
		buttonConsulta.setSize(10, 50);
		buttonExcluir.setText("EXCLUIR");
		buttonExcluir.setSize(10, 50);
		buttonSair.setText("SAIR");
		buttonSair.setSize(10, 50);

		janelaConsultaPasseio.add(labelPlaca);
		janelaConsultaPasseio.add(textPlaca);
		janelaConsultaPasseio.add(labelMarca);
		janelaConsultaPasseio.add(textMarca);
		janelaConsultaPasseio.add(labelModelo);
		janelaConsultaPasseio.add(textModelo);
		janelaConsultaPasseio.add(labelCor);
		janelaConsultaPasseio.add(textCor);
		janelaConsultaPasseio.add(labelQtdRodas);
		janelaConsultaPasseio.add(textQtdRodas);
		janelaConsultaPasseio.add(labelVelMax);
		janelaConsultaPasseio.add(textVelMax);
		janelaConsultaPasseio.add(labelQtdPist);
		janelaConsultaPasseio.add(textQtdPist);
		janelaConsultaPasseio.add(labelPotencia);
		janelaConsultaPasseio.add(textPotencia);
		janelaConsultaPasseio.add(labelQtdPassageiros);
		janelaConsultaPasseio.add(textQtdPassageiros);

		janelaConsultaPasseio.add(buttonConsulta);
		janelaConsultaPasseio.add(buttonExcluir);
		janelaConsultaPasseio.add(buttonSair);

		buttonConsulta.addActionListener(janelaConsPasseio);
		buttonExcluir.addActionListener(janelaConsPasseio);
		buttonSair.addActionListener(janelaConsPasseio);

		janelaConsultaPasseio.setLayout(new FlowLayout());
		janelaConsultaPasseio.setVisible(true);
	}

	@Override
	public void actionPerformed(ActionEvent e) {

		if(e.getSource().equals(buttonConsulta)) {
			passeio = new Passeio();
			passeio.setPlaca(textPlaca.getText());
			textMarca.setText(passeio.getMarca());
			textModelo.setText(passeio.getModelo());
			textCor.setText(passeio.getCor());
			textQtdRodas.setText(passeio.getQtdRodas().toString());
			try {
				passeio.setVelocMax(Integer.parseInt(textVelMax.getText()));
			} catch (NumberFormatException e1) {
				e1.printStackTrace();
			} catch (VelocException e1) {
				e1.printStackTrace();
			}
			passeio.getMotor().setQtdPist(Integer.parseInt(textQtdPist.getText()));
			passeio.getMotor().setPotencia(Integer.parseInt(textPotencia.getText()));
			passeio.setQtdPassageiros(Integer.parseInt(textQtdPassageiros.getText()));
			bdVeiculos.verificaPlaca(passeio.getPlaca());
			bdVeiculos.cadastroPasseio(passeio);
		}
		if(e.getSource().equals(buttonExcluir)) {
			textPlaca.setText("");
			textMarca.setText("");
			textModelo.setText("");
			textCor.setText("");
			textQtdRodas.setText("");
			textVelMax.setText("");
			textQtdPist.setText("");
			textPotencia.setText("");
			textQtdPassageiros.setText("");
		}
		if(e.getSource().equals(buttonSair)) {
			janelaConsultaPasseio.dispose();
		}
	}
}
